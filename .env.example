# PostgreSQL used by the homepage pipeline.
# In docker compose, "db" should resolve to the main Postgres service.
# For local development, change host/port/user/password as needed.
DATABASE_URL=postgresql://yanbridge:yanbridge@db:5432/yanbridge?sslmode=disable

# DeepSeek is required when running the LLM pipeline.
DEEPSEEK_API_KEY=

# Optional: where XHS/homepage media files are stored.
# Leave empty to use the pipeline default path.
MEDIA_ROOT=

# Optional: CRW service for the agent search/scrape tools.
# Example local CRW server: http://localhost:3000
CRW_API_URL=http://localhost:3000
CRW_API_KEY=
CRW_TIMEOUT=30

# Optional: PydanticAI model used by the teacher-post agent.
# Example: openai:gpt-4o-mini
AGENT_MODEL=deepseek-v4-flash
